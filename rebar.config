%% rebar3 builds the Erlang API (src/) and a loader for the NIF
%% (rebar/src/); Mix builds lib/ instead and only shares src/.
{erl_opts, [debug_info]}.

%% Mix also builds into _build/test/lib/torque; keep rebar3 apart from it.
{base_dir, "_build/rebar3"}.
{src_dirs, ["src", "rebar/src"]}.
{deps, []}.

%% Puts priv/native/torque_nif.so in place: the precompiled release asset, or
%% a cargo build with TORQUE_BUILD=true.
{pre_hooks, [{compile, "escript rebar/fetch_nif.escript"}]}.
